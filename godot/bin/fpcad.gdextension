[configuration]

entry_symbol = "fpcad_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

windows.debug.x86_64 = "res://bin/libfpcad.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libfpcad.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libfpcad.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libfpcad.linux.template_release.x86_64.so"
android.debug.arm64 = "res://bin/libfpcad.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/libfpcad.android.template_release.arm64.so"

[dependencies]

; Open CASCADE ships beside the extension as shared libraries (LGPL relinking).
; tools/stage_occt.py copies the toolkits into godot/bin/ and adds one line per platform here.
